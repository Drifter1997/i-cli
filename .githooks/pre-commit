#!/usr/bin/env bash
# ==============================================================================
# i-cli Pre-Commit Hook: Automated Secret & Credential Leak Prevention
# Guarantees that credentials, session cookies, and tokens are NEVER committed.
# ==============================================================================

set -e

RED="\033[31m\033[1m"
GREEN="\033[32m\033[1m"
YELLOW="\033[33m\033[1m"
RESET="\033[0m"

# 1. Block prohibited file names from ever being staged
BLOCKED_PATTERNS="(session\.json|device\.json|\.env|\.cookie|\.session|credentials|token)"

STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
    basename=$(basename "$file")
    if echo "$basename" | grep -iE "$BLOCKED_PATTERNS" >/dev/null 2>&1; then
        echo -e "${RED}[SECURITY ERROR] Prohibited credential file detected:${RESET} $file"
        echo -e "${YELLOW}Credentials must NEVER be committed to Git!${RESET}"
        echo -e "Sessions are automatically stored in ~/.config/i-cli/session.json (outside this repo)."
        exit 1
    fi
done

# 2. Block accidental inline credentials or private keys in staged diffs
# Check for raw sessionid tokens or private keys (ignore setup/test code templates)
if git diff --cached -U0 | grep -E "^\+[[:space:]]*(sessionid|ds_user_id)[[:space:]]*=[[:space:]]*['\"][0-9a-zA-Z%_-]{10,}['\"]" >/dev/null 2>&1; then
    echo -e "${RED}[SECURITY ERROR] Staged diff contains hardcoded session token!${RESET}"
    echo -e "${YELLOW}Please remove raw authentication tokens before committing.${RESET}"
    exit 1
fi

if git diff --cached -U0 | grep -E "^\+[[:space:]]*-----BEGIN [A-Z ]*PRIVATE KEY-----" >/dev/null 2>&1; then
    echo -e "${RED}[SECURITY ERROR] Staged diff contains private cryptographic key!${RESET}"
    exit 1
fi

exit 0
